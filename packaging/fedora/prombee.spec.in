Name:           prombee
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Lightweight desktop prompt editor
License:        Apache-2.0
URL:            https://github.com/Flo-Ari/Prombee
Source0:        %{name}-%{version}.tar.gz
BuildArch:      noarch
Requires:       python3 >= 3.10
Requires:       python3-gobject
Requires:       polkit
Requires:       gtk4
Requires:       webkitgtk6.0
Requires:       xorg-x11-server-Xwayland
Requires:       libX11
Requires:       libXext

%description
Prombee is a lightweight prompt editor with hierarchical Markdown,
round history, templates, reusable prompts and a floating AI bee.
Uses Fedora's native GTK 4 and WebKitGTK 6 libraries.

%prep
%setup -q

%build

%install
mkdir -p %{buildroot}%{_datadir}/prombee
cp -a desktop.py seed.json src web %{buildroot}%{_datadir}/prombee/
install -Dpm 755 packaging/debian/prombee %{buildroot}%{_bindir}/prombee
install -Dpm 644 packaging/debian/prombee.desktop %{buildroot}%{_datadir}/applications/prombee.desktop
install -Dpm 644 web/logo.svg %{buildroot}%{_datadir}/icons/hicolor/scalable/apps/prombee.svg

%files
%license LICENSE NOTICE
%{_bindir}/prombee
%{_datadir}/prombee
%{_datadir}/applications/prombee.desktop
%{_datadir}/icons/hicolor/scalable/apps/prombee.svg
